generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  pin       String   @default("0000")
  isGuest   Boolean  @default(false)

  // Relación con torneos
  tournamentParticipations TournamentParticipant[]

  @@map("players")
}

model Circuit {
  id                        String    @id @default(cuid())
  name                      String
  imageUrl                  String
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  bestAverageHolderId       String?
  bestLapHolderId           String?
  historicalBestAverage     Int?
  historicalBestAverageDate DateTime?
  historicalBestLap         Int?
  historicalBestLapDate     DateTime?

  @@map("circuits")
}

model Game {
  id        String   @id @default(cuid())
  state     Json
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Campos para torneos
  gameMode     String      @default("custom") // quick, custom, tournament
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  position     Int?        // Posición del campeonato en el torneo (1, 2, 3...)

  @@index([tournamentId])
  @@map("games")
}

model Settings {
  id                    String    @id @default("singleton")
  pin                   String    @default("2024")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  tournamentsEnabled    Boolean   @default(false)
  historicalCutoffDate  DateTime? // Fecha de corte para estadísticas históricas

  @@map("settings")
}

model IndividualLapTime {
  id         String   @id @default(cuid())
  gameId     String
  playerId   String
  circuitId  String
  turnNumber Int
  lapNumber  Int
  timeMs     Int
  isSaved    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([gameId, playerId, circuitId, turnNumber, lapNumber])
  @@index([gameId, circuitId, turnNumber])
  @@index([gameId, playerId, circuitId, turnNumber])
  @@map("individual_lap_times")
}

model TurnCompletion {
  id            String    @id @default(cuid())
  gameId        String
  playerId      String
  circuitId     String
  turnNumber    Int
  averageTimeMs Int?
  turnScore     Int?
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([gameId, playerId, circuitId, turnNumber])
  @@map("turn_completions")
}

model Tournament {
  id               String                  @id @default(cuid())
  name             String
  description      String?
  status           String                  @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  pointsForFirst   Int                     @default(3)
  pointsForSecond  Int                     @default(2)
  pointsForThird   Int                     @default(1)
  startDate        DateTime                @default(now())
  endDate          DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  // Tracking de circuitos ya jugados en este torneo
  playedCircuitIds String[]                @default([])

  // Relaciones
  games            Game[]
  participants     TournamentParticipant[]
  championships    Championship[]          // DEPRECATED - mantener por compatibilidad

  @@map("tournaments")
}

// DEPRECATED: Usar Game con tournamentId en su lugar
// Se mantiene por compatibilidad con datos existentes
model Championship {
  id           String     @id @default(cuid())
  tournamentId String
  name         String
  gameState    Json
  status       String     @default("ACTIVE")
  position     Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("championships")
}

model TournamentParticipant {
  id                  String     @id @default(cuid())
  tournamentId        String
  playerId            String
  totalPoints         Int        @default(0)
  championshipsWon    Int        @default(0)
  championshipsSecond Int        @default(0)
  championshipsThird  Int        @default(0)
  championshipsPlayed Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relaciones
  tournament          Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player              Player     @relation(fields: [playerId], references: [id])

  @@unique([tournamentId, playerId])
  @@index([playerId])
  @@map("tournament_participants")
}
