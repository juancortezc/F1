generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  pin       String   @default("0000")

  @@map("players")
}

model Circuit {
  id                        String    @id @default(cuid())
  name                      String
  imageUrl                  String
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  bestAverageHolderId       String?
  bestLapHolderId           String?
  historicalBestAverage     Int?
  historicalBestAverageDate DateTime?
  historicalBestLap         Int?
  historicalBestLapDate     DateTime?

  @@map("circuits")
}

model Game {
  id        String   @id @default(cuid())
  state     Json
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("games")
}

model Settings {
  id                 String   @id @default("singleton")
  pin                String   @default("2024")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tournamentsEnabled Boolean  @default(false)

  @@map("settings")
}

model IndividualLapTime {
  id         String   @id @default(cuid())
  gameId     String
  playerId   String
  circuitId  String
  turnNumber Int
  lapNumber  Int
  timeMs     Int
  isSaved    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([gameId, playerId, circuitId, turnNumber, lapNumber])
  @@index([gameId, circuitId, turnNumber])
  @@index([gameId, playerId, circuitId, turnNumber])
  @@map("individual_lap_times")
}

model TurnCompletion {
  id            String    @id @default(cuid())
  gameId        String
  playerId      String
  circuitId     String
  turnNumber    Int
  averageTimeMs Int?
  turnScore     Int?
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([gameId, playerId, circuitId, turnNumber])
  @@map("turn_completions")
}

model Tournament {
  id               String                  @id @default(cuid())
  name             String
  description      String?
  status           String                  @default("ACTIVE")
  maxChampionships Int                     @default(5)
  pointsForFirst   Int                     @default(3)
  pointsForSecond  Int                     @default(2)
  pointsForThird   Int                     @default(1)
  startDate        DateTime                @default(now())
  endDate          DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  championships    Championship[]
  participants     TournamentParticipant[]

  @@map("tournaments")
}

model Championship {
  id           String     @id @default(cuid())
  tournamentId String
  name         String
  gameState    Json
  status       String     @default("ACTIVE")
  position     Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("championships")
}

model TournamentParticipant {
  id                  String     @id @default(cuid())
  tournamentId        String
  playerId            String
  totalPoints         Int        @default(0)
  championshipsWon    Int        @default(0)
  championshipsSecond Int        @default(0)
  championshipsThird  Int        @default(0)
  championshipsTotal  Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  tournament          Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
  @@map("tournament_participants")
}
